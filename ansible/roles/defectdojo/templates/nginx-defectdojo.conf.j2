# {{ ansible_managed }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ defectdojo_hostname }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ defectdojo_hostname }};

    ssl_certificate     {{ defectdojo_tls_dir }}/{{ defectdojo_hostname }}.crt;
    ssl_certificate_key {{ defectdojo_tls_dir }}/{{ defectdojo_hostname }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Import de rapports de scanners : fichiers parfois volumineux
    client_max_body_size {{ defectdojo_upload_max }};

    location / {
        proxy_pass http://127.0.0.1:{{ defectdojo_local_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
