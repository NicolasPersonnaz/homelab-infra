# {{ ansible_managed }}
FROM {{ ci_image_base }}

ENV DEBIAN_FRONTEND=noninteractive \
    PIPX_HOME=/opt/pipx \
    PIPX_BIN_DIR=/usr/local/bin

# Outils Debian 13 : mêmes versions d'Ansible que sur la VM de gestion
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-client ansible ansible-lint yamllint pipx \
 && rm -rf /var/lib/apt/lists/*

# Dépôts signés : HashiCorp (terraform) et Teleport (tbot, tsh, tctl), versions épinglées
RUN curl -fsSL https://apt.releases.hashicorp.com/gpg -o /usr/share/keyrings/hashicorp.asc \
 && echo "deb [signed-by=/usr/share/keyrings/hashicorp.asc] https://apt.releases.hashicorp.com trixie main" \
      > /etc/apt/sources.list.d/hashicorp.list \
 && curl -fsSL https://apt.releases.teleport.dev/gpg -o /usr/share/keyrings/teleport.asc \
 && echo "deb [signed-by=/usr/share/keyrings/teleport.asc] https://apt.releases.teleport.dev/debian trixie stable/v18" \
      > /etc/apt/sources.list.d/teleport.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      terraform={{ ci_image_terraform_version }} teleport={{ ci_image_teleport_version }} \
 && rm -rf /var/lib/apt/lists/*

# gitleaks : binaire officiel, somme SHA-256 vérifiée avant extraction
RUN curl -fsSLo /tmp/gitleaks.tar.gz \
      https://github.com/gitleaks/gitleaks/releases/download/v{{ ci_image_gitleaks_version }}/gitleaks_{{ ci_image_gitleaks_version }}_linux_x64.tar.gz \
 && echo "{{ ci_image_gitleaks_sha256 }}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
 && rm /tmp/gitleaks.tar.gz

# semgrep : environnement Python isolé (pipx), version épinglée
RUN pipx install semgrep=={{ ci_image_semgrep_version }}
