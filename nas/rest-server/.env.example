# Copier en .env sur le NAS et adapter. Ce fichier ne contient aucun secret :
# les comptes sont créés dans le conteneur, mot de passe saisi à l'invite.

# Adresse LAN du NAS sur laquelle publier le port 8000
REST_SERVER_BIND=192.168.1.50

# Dossier des dépôts restic sur le NAS (chemin du volume de stockage)
REST_SERVER_DATA=/volume1/backups/restic

# Utilisateur et groupe propriétaires de REST_SERVER_DATA (id -u / id -g)
PUID=1000
PGID=10
